<?xml version="1.0" encoding="utf-8"?>
<set
  xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="2800" android:repeatCount="infinite">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="translateY">
            <keyframe android:value="6" android:fraction="0.0" />
            <keyframe android:value="-10" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="2800" android:repeatCount="infinite">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="translateX">
            <keyframe android:value="0" android:fraction="0.0" />
            <keyframe android:value="5" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
</set>