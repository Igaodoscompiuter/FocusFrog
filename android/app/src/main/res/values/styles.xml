<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Cor da barra de status já no tema nativo, pra aparecer certa desde o
             1º frame (sem esperar o JS do StatusBar plugin rodar e sem depender
             de nenhum hack de edge-to-edge). -->
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <!-- [CORREÇÃO DE VERDADE] A tentativa anterior (windowOptOutEdgeToEdgeEnforcement
             sozinho) não bastava — o próprio fórum oficial do Capacitor confirma que isso
             sozinho não resolve, e esse atributo é desativado no Android 16. A solução
             oficial e definitiva é a config adjustMarginsForEdgeToEdge do Capacitor
             (ver capacitor.config.json), que já faz tudo isso certo e vai virar o padrão
             no Capacitor 8 — então nada precisa ficar aqui no tema. -->
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>