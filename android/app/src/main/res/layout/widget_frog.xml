<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Sapo do Dia": quatro estados, um visível por vez (FrogWidgetProvider)
     ativo: tarefa + passos + botão   |  vazio: escolher um sapo
     feito: parabéns + "outro?"       |  descanso: até amanhã -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- ATIVO -->
    <LinearLayout
        android:id="@+id/frog_state_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_stat_frog" />
            <TextView
                android:id="@+id/frog_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sapo do Dia"
                android:textColor="#8BD150"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/frog_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:gravity="center_vertical"
            android:textColor="#F3F4F6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/frog_steps_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ProgressBar
                android:id="@+id/frog_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/widget_frog_progress" />
            <TextView
                android:id="@+id/frog_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/frog_btn_open"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="Começar foco"
            android:textColor="#071006"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- VAZIO -->
    <LinearLayout
        android:id="@+id/frog_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐸"
            android:textSize="28sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Qual vai ser o seu Sapo de hoje?"
            android:textColor="#F3F4F6"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/frog_btn_choose"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="Escolher sapo"
            android:textColor="#071006"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FEITO -->
    <LinearLayout
        android:id="@+id/frog_state_done"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🎉 Sapo engolido!"
            android:textColor="#F3F4F6"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/frog_done_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ainda tem energia pra outro?"
            android:textColor="#D1D5DB"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/frog_btn_another"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_primary"
                android:gravity="center"
                android:text="Escolher outro"
                android:textColor="#071006"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/frog_btn_rest"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_btn_secondary"
                android:gravity="center"
                android:text="Por hoje chega"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- DESCANSO -->
    <LinearLayout
        android:id="@+id/frog_state_rest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="26sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Bom trabalho hoje."
            android:textColor="#F3F4F6"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Amanhã tem sapo novo 🐸"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
