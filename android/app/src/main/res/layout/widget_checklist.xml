<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Cabeçalho: ícone + título + progresso "X/Y" + botão de resetar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_stat_frog" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já pegou?"
                android:textColor="#F3F4F6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_reset_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/widget_icon_button_bg"
            android:src="@drawable/widget_reset_icon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="#2D3748" />

    <!-- Grade 2 colunas x 3 linhas (6 vagas). O Java decide em tempo real
         quantas colunas/linhas mostrar, de acordo com a largura/altura reais
         que a pessoa escolheu ao redimensionar o widget na tela inicial. -->
    <LinearLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Linha 1 -->
        <LinearLayout
            android:id="@+id/widget_grid_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/widget_row_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/widget_icon_1" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_row_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingStart="6dp">
                <ImageView android:id="@+id/widget_icon_2" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Linha 2 -->
        <LinearLayout
            android:id="@+id/widget_grid_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/widget_row_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/widget_icon_3" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_row_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingStart="6dp">
                <ImageView android:id="@+id/widget_icon_4" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Linha 3 -->
        <LinearLayout
            android:id="@+id/widget_grid_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/widget_row_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/widget_icon_5" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_row_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp" android:paddingStart="6dp">
                <ImageView android:id="@+id/widget_icon_6" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_checkbox_unchecked" />
                <TextView android:id="@+id/widget_text_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Estado vazio -->
    <TextView
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Nenhum item ainda. Abra o app pra adicionar."
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
