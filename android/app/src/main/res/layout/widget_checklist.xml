<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Cabeçalho: ícone + título + progresso "X/Y" + botão de resetar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_stat_frog" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já pegou?"
                android:textColor="#F3F4F6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_reset_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/widget_icon_button_bg"
            android:src="@drawable/widget_reset_icon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="#2D3748" />

    <!-- [NOVO] GridView nativo em vez de um grid fixo "na mão": numColumns
         auto_fit decide SOZINHO quantas colunas cabem pela largura real do
         widget (1 coluna estreita = vira lista; largo = 2-3 colunas), e rola
         verticalmente por padrão quando os itens não cabem na altura — é a
         ferramenta certa do Android pra exatamente esse problema, em vez de
         eu tentar recriar isso manualmente com linhas fixas que escondiam
         item ou cortavam na borda. -->
    <!-- [CORREÇÃO] stretchMode="columnWidth" esticava a LARGURA de cada coluna
         pra preencher o espaço sobrando — item curto tipo "Chaves" virava uma
         coluna enorme com muito vão vazio antes da próxima. spacingWidthUniform
         mantém cada item perto do tamanho natural e distribui a sobra como
         espaçamento, não como largura de célula. columnWidth menor (110dp)
         também deixa mais colunas caberem em widgets largos, sobrando menos
         espaço pra redistribuir em primeiro lugar. -->
    <GridView
        android:id="@+id/widget_grid_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="auto_fit"
        android:columnWidth="110dp"
        android:stretchMode="spacingWidthUniform"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="0dp"
        android:gravity="start"
        android:scrollbars="none" />

    <!-- Estado vazio (GridView esconde sozinho via setEmptyView quando tem item) -->
    <TextView
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Nenhum item ainda. Abra o app pra adicionar."
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
