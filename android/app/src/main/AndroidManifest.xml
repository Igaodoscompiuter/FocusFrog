<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- o ícone do launcher fica nos activity-alias abaixo (ícone com o humor do sapo) -->
            <!-- volta do login (Google/Facebook): o navegador abre
                 com.focusfrog.app://auth-callback?code=... e cai aqui -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.focusfrog.app" android:host="auth-callback" />
            </intent-filter>
            <!-- botão "Abrir o FocusFrog" do site (focusfrog://open) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="focusfrog" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Ícone com o humor do sapo (MascotIcon troca qual alias fica ligado;
             só um por vez). LauncherDefault é o ícone normal do app. -->
        <activity-alias
            android:name=".LauncherSad"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_mood_sad"
            android:roundIcon="@mipmap/ic_mood_sad"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSleepy"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_mood_sleepy"
            android:roundIcon="@mipmap/ic_mood_sleepy"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherHappy"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_mood_happy"
            android:roundIcon="@mipmap/ic_mood_happy"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNormal"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_mood_normal"
            android:roundIcon="@mipmap/ic_mood_normal"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Recados do sapo (MascotNudge): agenda os horários do dia, refaz depois
             de reiniciar/atualizar e troca o ícone com o humor -->
        <receiver
            android:name=".MascotNudge"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.focusfrog.app.MASCOT_NUDGE" />
                <action android:name="com.focusfrog.app.MASCOT_ICON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Serviço em primeiro plano: mantém a sessão de foco (Pomodoro) ativa e visível
             (notificação fixa) mesmo com o app minimizado, igual um player de música.
             Tipo "specialUse": nenhuma das categorias pré-definidas do Android (localização,
             mídia, saúde etc.) descreve um timer de produtividade — ao publicar na Play,
             esse tipo é revisado manualmente, então a justificativa abaixo precisa bater com
             o motivo real de uso. -->
        <service
            android:name=".PomodoroForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantém visível o cronômetro de uma sessão de foco (Pomodoro) em andamento, com notificação fixa mostrando o tempo restante, mesmo com o app em segundo plano." />
        </service>

        <!-- Widget de tela inicial "Sapo do Dia" -->
        <receiver
            android:name=".FrogWidgetProvider"
            android:exported="false"
            android:label="Sapo do Dia">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusfrog.app.FROG_WIDGET_REST" />
                <action android:name="com.focusfrog.app.FROG_WIDGET_STEP" />
                <action android:name="com.focusfrog.app.FROG_WIDGET_DONE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/frog_widget_info" />
        </receiver>

        <!-- Widget do mascote (carinho e mosca) -->
        <receiver
            android:name=".MascotWidgetProvider"
            android:exported="false"
            android:label="Mascote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusfrog.app.MASCOT_PET" />
                <action android:name="com.focusfrog.app.MASCOT_FEED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mascot_widget_info" />
        </receiver>

        <!-- Widget "Agenda de hoje" -->
        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="false"
            android:label="Agenda de hoje">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusfrog.app.AGENDA_WIDGET_ITEM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <!-- Widget de tela inicial do checklist "Já pegou?" -->
        <receiver
            android:name=".ChecklistWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusfrog.app.WIDGET_TOGGLE_ITEM" />
                <action android:name="com.focusfrog.app.WIDGET_RESET_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/checklist_widget_info" />
        </receiver>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notificação de fim de foco/pausa precisa disparar mesmo com o app fechado -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Serviço em primeiro plano do Pomodoro (ver <service> acima) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Recados do sapo: reagendar depois de reiniciar o celular -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
