# Supabase (Settings → API do projeto). A anon key é pública por definição:
# a segurança vem do Row Level Security nas tabelas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Arquivo com a versão mais recente do APK (aviso de nova versão no app)
VITE_UPDATE_MANIFEST_URL=https://focusfrog.netlify.app/update.json
